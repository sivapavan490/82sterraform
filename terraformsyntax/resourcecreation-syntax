resource "type-of-resource"   "name-of-resource"{
            (name is fixed)         (any name)

    required paarameters
}

ex:-


# INSTANCE CREATION RESOURCE EXAMPLE
resource "aws_instance" "web" {
  ami           = "resolve:ssm:/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64"
  instance_type = "t3.micro"

  tags = {
    Name = "HelloWorld"
  }
}


# SECURITY GROUP CREATION RESOURCE EXAMPLE
resource "aws_security_group" "securitygroup_creation" {
  name        = "siva" # security group name
  description = "Allow TLS inbound traffic and all outbound traffic"
    ingress {
    from_port        = 22
    to_port          = 22
    protocol         = "tcp"
    cidr_blocks      = ["0.0.0.0/0"]
    
  }
  egress {
    from_port        = 0
    to_port          = 0
    protocol         = "-1"
    cidr_blocks      = ["0.0.0.0/0"]
    
  }
  tags = {
    Name = "pavan" # name
    
  }
}

# refer 1 resource into another resource syntax in below:-

        type_of_resource.name_of_resource.

        ex:- aws_security_group.securitygroup_creation.id


